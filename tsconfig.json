{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "skipLibCheck": true,
    "types": ["node"],
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": ["index.ts", "tui.ts", "rpc.ts", "src/**/*", "test/**/*", "scripts/**/*"]
}
